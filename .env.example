# Cap Immo Tanger — Backend env
# انسخ إلى .env. لا تضع هذا الملف (ولا .env) في git أبداً.

# المنفذ
PORT=3100

# قاعدة البيانات — تُفضَّل DATABASE_URL:
#   محلي (ملف SQLite):  DATABASE_URL=file:/absolute/path/capimmo.db
#   تُرسو (سحابي دائم):  DATABASE_URL=libsql://your-db.turso.io
#                        DATABASE_AUTH_TOKEN=<redacted>
# إن لم تُضبط DATABASE_URL يُستعمل DATABASE_PATH (يُحوَّل إلى file: تلقائياً)
DATABASE_URL=
DATABASE_AUTH_TOKEN=
DATABASE_PATH=./data/capimmo.db

# مزود الذكاء الاصطناعي: local | qwen | deepseek | glm | openai
AI_PROVIDER=local
# مفتاح المزود — يبقى في السيرفر فقط، ممنوع في الواجهة
AI_API_KEY=
# (اختياري) تجاوز العنوان/الموديل الافتراضي للمزود
AI_API_BASE=
AI_MODEL=
# مهلة مزود LLM بالميلي ثانية
AI_TIMEOUT_MS=25000

# الأمان
# مصدر الواجهة المسموح (CORS) — عدّله عند النشر
CORS_ORIGIN=https://bofrahi12.github.io
# سر توقيع رموز الإدارة — غيّره بقيمة عشوائية طويلة
TOKEN_SECRET=change-me-to-a-long-random-secret
# بيانات مدير أولي (تُستعمل مرة واحدة عبر npm run seed-admin)
ADMIN_PHONE=0693981822
ADMIN_EMAIL=
ADMIN_PASSWORD=change-me-immediately

# الحدود (طلب/دقيقة/IP)
RATE_LIMIT_GENERAL=120
RATE_LIMIT_AI=30
RATE_LIMIT_LEADS=20
RATE_LIMIT_LOGIN=10

# رقم الوكالة (ثابت — لا تغيّر)
AGENCY_PHONE=0693981822
